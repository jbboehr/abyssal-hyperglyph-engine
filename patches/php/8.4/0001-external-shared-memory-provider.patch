+#ifndef ZEND_SHARED_ALLOC_PROVIDER_H
+#define ZEND_SHARED_ALLOC_PROVIDER_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define ZEND_OPCACHE_SHM_PROVIDER_ABI_V1 1u
+#define ZEND_OPCACHE_SHM_PROVIDER_REGISTER_SYMBOL_V1 \
+	"zend_opcache_register_shared_memory_provider_v1"
+
+#define ZEND_OPCACHE_SHM_PROVIDER_SUCCESS 0
+#define ZEND_OPCACHE_SHM_PROVIDER_FAILURE -1
+
+#define ZEND_OPCACHE_SHM_ALLOC_FAILURE 0
+#define ZEND_OPCACHE_SHM_ALLOC_SUCCESS 1
+#define ZEND_OPCACHE_SHM_FAILED_REATTACHED 2
+#define ZEND_OPCACHE_SHM_SUCCESSFULLY_REATTACHED 4
+
+typedef struct _zend_shared_segment {
+	size_t size;
+	size_t end;
+	size_t pos;
+	void *p;
+} zend_opcache_shm_segment_v1;
+
+typedef struct _zend_opcache_shm_provider_v1 {
+	uint32_t abi_version;
+	uint32_t struct_size;
+	const char *name;
+	void *context;
+
+	int (*create_segments)(
+		void *context,
+		size_t requested_size,
+		zend_opcache_shm_segment_v1 ***shared_segments,
+		int *shared_segment_count,
+		void **reattached_shared_globals,
+		const char **error_in
+	);
+	int (*detach_segment)(void *context, zend_opcache_shm_segment_v1 *shared_segment);
+	size_t (*segment_type_size)(void *context);
+
+	int (*lock)(void *context);
+	int (*unlock)(void *context);
+
+	void (*startup_complete)(void *context, int reattached, void *shared_globals);
+	void (*startup_aborted)(void *context, const char *reason);
+	void (*shutdown)(void *context);
+} zend_opcache_shm_provider_v1;
+
+typedef int (*zend_opcache_register_shared_memory_provider_v1_t)(
+	const zend_opcache_shm_provider_v1 *provider
+);
+
+#endif /* ZEND_SHARED_ALLOC_PROVIDER_H */
