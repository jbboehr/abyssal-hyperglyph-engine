+static bool zend_shared_alloc_provider_segments_are_valid(
+	zend_shared_segment **shared_segments,
+	int shared_segment_count
+)
+{
+	int i;
+
+	if (!shared_segments || shared_segment_count <= 0) {
+		return false;
+	}
+
+	for (i = 0; i < shared_segment_count; i++) {
+		zend_shared_segment *segment = shared_segments[i];
+
+		if (!segment || !segment->p || segment->p == (void *) -1 || !segment->size) {
+			return false;
+		}
+	}
+
+	return true;
+}
+
+static bool zend_shared_alloc_provider_segment_contains(
+	zend_shared_segment *segment,
+	void *address,
+	size_t size
+)
+{
+	uintptr_t start = (uintptr_t) segment->p;
+	uintptr_t candidate = (uintptr_t) address;
+
+	return candidate >= start
+		&& candidate - start <= segment->size
+		&& size <= segment->size - (candidate - start);
+}
+
+static int zend_shared_alloc_provider_create_segments(
+	size_t requested_size,
+	zend_shared_segment ***shared_segments,
+	int *shared_segment_count,
+	const char **error_in
+)
+{
+	int result;
+
+	g_shared_alloc_provider_reattached_globals = NULL;
+	result = g_shared_alloc_provider.create_segments(
+		g_shared_alloc_provider.context,
+		requested_size,
+		shared_segments,
+		shared_segment_count,
+		&g_shared_alloc_provider_reattached_globals,
+		error_in
+	);
+
+	switch (result) {
+		case ALLOC_FAILURE:
+		case FAILED_REATTACHED:
+			return result;
+		case ALLOC_SUCCESS:
+			if (zend_shared_alloc_provider_segments_are_valid(
+				*shared_segments,
+				*shared_segment_count
+			)) {
+				return result;
+			}
+			*error_in = "external provider returned invalid shared memory segments";
+			return ALLOC_FAILURE;
+		case SUCCESSFULLY_REATTACHED:
+			if (zend_shared_alloc_provider_segments_are_valid(
+				*shared_segments,
+				*shared_segment_count
+			)
+			 && g_shared_alloc_provider_reattached_globals) {
+				int i;
+
+				for (i = 0; i < *shared_segment_count; i++) {
+					zend_shared_segment *segment = (*shared_segments)[i];
+
+					if (zend_shared_alloc_provider_segment_contains(
+						segment,
+						g_shared_alloc_provider_reattached_globals,
+						sizeof(zend_smm_shared_globals)
+					)) {
+						return result;
+					}
+				}
+			}
+			*error_in = "external provider returned invalid reattached shared globals";
+			return ALLOC_FAILURE;
+		default:
+			*error_in = "external provider returned an unsupported allocation status";
+			return ALLOC_FAILURE;
+	}
+}
+
+static int zend_shared_alloc_provider_detach_segment(zend_shared_segment *shared_segment)
+{
+	return g_shared_alloc_provider.detach_segment(
+		g_shared_alloc_provider.context,
+		shared_segment
+	);
+}
+
+static size_t zend_shared_alloc_provider_segment_type_size(void)
+{
+	return g_shared_alloc_provider.segment_type_size(g_shared_alloc_provider.context);
+}
+
+static const zend_shared_memory_handlers provider_handlers = {
+	zend_shared_alloc_provider_create_segments,
+	zend_shared_alloc_provider_detach_segment,
+	zend_shared_alloc_provider_segment_type_size,
+};
